---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    title: 'Software Executive',
    organization: 'Mechatronics and Robotics Society (MARS) · Charlottesville, VA · January 2026 – Present',
    description: [
      'Awarded first place in a NASA competition against 47 colleges and universities.',
      'Worked across software, electrical, and mechanical sub-teams, including Mission Control at Kennedy Space Center for NASA Lunabotics.',
      'Contributed real-time UI updates from sensor feedback and dig/dump autonomy after joining a semester late, then selected as software lead for next year.',
    ],
  },
  {
    title: 'IT Developer',
    organization: 'Trusted Care Foundation · Fairfax, VA · June 2025 – August 2026',
    description: [
      'Collaborated with developers and managers on an app connected to HubSpot CRM for real-time updates across thousands of contacts.',
      'Integrated external software with HubSpot to gather and display data, and published a website for students to sign up for medical trainings.',
    ],
  },
  {
    title: 'ML Intern',
    organization: 'LGI Tech · Leesburg, VA · July 2026 – August 2026',
    description: [
      'Interned under an ex-Google engineer on transcription refinement via LLM output.',
      'Wrote prompts and scripts to parse JSON output, update transcriptions, and evaluate the approach with false-positive and true-positive rates.',
    ],
  },
];

const projects = [
  {
    title: 'MARS NASA Lunabotics Robot',
    href: 'https://marsatuva.org/',
    description: 'ROS2 Action Server for dig/dump autonomy, C++ sockets feeding a React UI in real time, and GitHub Pages documentation — built with MARS, January 2026 – Present.',
    tags: ['ROS2', 'C++', 'React'],
  },
  {
    title: 'Incremental Haven',
    href: 'https://ethanedwards.dev/Incremental-Haven/',
    description: 'A personal game that tracks 10+ values, structured modularly for later additions, with a research notebook of the development process. August 2024 – June 2025.',
    tags: ['Game', 'JavaScript'],
  },
];
---
<BaseLayout title="Ethan Edwards | Developer" description="Ethan Edwards, a Computer Science student at the University of Virginia.">
  <header class="site-header">
    <div class="site-header-inner page-width">
      <a class="wordmark" href="#top" aria-label="Back to the top">ethanedwards.dev</a>
      <nav aria-label="Main navigation">
        <a href="#top">Home</a>
        <a href="#projects">Projects</a>
        <a href="/resume.pdf">Resume</a>
      </nav>
    </div>
  </header>

  <main id="top" class="page-width">
    <section class="intro" aria-labelledby="intro-title">
      <p class="eyebrow">Hello, I'm Ethan</p>
      <h1 id="intro-title">Computer science at UVA</h1>
    </section>

    <section id="about" class="about section-grid" aria-labelledby="about-title">
        <div class="portrait-frame">
          <img class="portrait-placeholder" src="/portrait.jpg" alt="Ethan Edwards pointing at the water with teammates on a pier" />
        </div>
      <div class="about-copy ruled-panel">
        <h2 id="about-title">About me</h2>
        <p>Replace this with your own writing. Starter from the resume: University of Virginia, B.A. in Computer Science, May 2028, GPA 3.79 / 4.0. Software Executive with the Mechatronics and Robotics Society in Charlottesville.</p>
        <p>Python, C++, C#, Java, JavaScript/TypeScript, C, SQL, HTML/CSS, Node.js. ROS2, Unity, Git, Django, React.</p>
      </div>
    </section>

    <section id="experience" class="experience section-block" aria-labelledby="experience-title">
      <h2 id="experience-title" class="section-title">Work experience</h2>
      <div class="experience-list">
        {experience.map((role) => (
          <article class="work-card ruled-panel">
            <h3>{role.title}</h3>
            <p class="item-org">{role.organization}</p>
            {role.description.map((paragraph) => <p>{paragraph}</p>)}
          </article>
        ))}
      </div>
    </section>

    <section id="projects" class="projects section-block" aria-labelledby="projects-title">
      <h2 id="projects-title" class="section-title">Personal projects</h2>
      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-heading">
              <h3>{project.title}</h3>
              <a href={project.href} aria-label={`View ${project.title}`}>↗</a>
            </div>
            <p>{project.description}</p>
            <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer id="contact" class="site-footer">
    <div class="page-width footer-inner">
      <div>
        <p class="section-kicker">Contact me at:</p>
        <h2><a href="mailto:ethan.edwards750@gmail.com">ethan.edwards750@gmail.com</a></h2>
      </div>
      <div class="contact-links">
        <div class="social-links">
          <a href="https://github.com/NoodleBirb">GitHub</a>
          <a href="https://www.linkedin.com/in/ethan-edwards-14b537367/">LinkedIn</a>
          <a href="/past-projects/">Past projects</a>
          <a href="/resume.pdf">Resume</a>
          <a href="#top">Back to top ↑</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom page-width"><span>© 2026 Ethan Edwards</span></div>
  </footer>
</BaseLayout>
