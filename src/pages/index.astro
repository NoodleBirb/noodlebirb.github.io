---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience: {
  title: string;
  detailHref: string;
  organization: string;
  description: string[];
  image?: string;
  imageFit?: 'contain';
}[] = [
  {
    title: 'Software Executive',
    detailHref: '/experience/mars/',
    organization: 'Mechatronics and Robotics Society (MARS) · Charlottesville, VA · January 2026 – Present',
    description: [
      'Currently this is the project I\'m most passionate about because the people around me are so amazing!',
      'I lead 10+ software developers within our 140+ member robotics organization, bringing together work on autonomy, perception, navigation, and control.',
      'Before becoming Software Executive, I was the main point of contact for our autonomy stack. I contributed autonomous systems and on-site mission control to our first-place NASA Lunabotics and third-place international Lunabotics finishes.',
    ],
    image: '/grandprize2026.jpg',
  },
  {
    title: 'IT Developer',
    detailHref: '/experience/trusted-care-foundation/',
    organization: 'Trusted Care Foundation · Fairfax, VA · June 2025 – August 2026',
    description: [
      'This was my first real-world experience in software, and I had to learn to work with a small team of people and create a product that satisfied my customers.',
      'I built and deployed a medical-training registration website serving 100+ monthly users, refining it through stakeholder feedback. Connecting registration and CRM data workflows also saved upper management 3+ hours every two weeks.',
    ],
    image: '/tcfbanner.png',
    imageFit: 'contain',
  },
  {
    title: 'Machine Learning Intern',
    detailHref: '/experience/lgi-tech/',
    organization: 'LGI Tech · Leesburg, VA · July 2026 – August 2026',
    description: [
      'Here, I interned under an ex-Google engineer and learned how to work with LLMs and a large-scale production repository.',
      'I developed an LLM-assisted transcription refinement pipeline in Python, using prompt engineering to parse structured JSON output and apply corrections. I measured false-positive and true-positive rates to evaluate how accurate and reliable those corrections were.',
    ],
    image: '/ChatGPT-Logo.png',
    imageFit: 'contain',
  },
];

const projects: {
  title: string;
  detailHref: string;
  href?: string;
  description: string;
  tags: string[];
  image?: string;
  imageAlt?: string;
  imageFit?: 'contain';
}[] = [
  {
    title: 'MARS NASA Lunabotics Robot',
    detailHref: '/projects/mars-lunabotics/',
    href: 'https://marsatuva.org/',
    description: 'I architected and implemented a ROS 2 state machine and autonomous excavation/dumping systems using asynchronous Actions. The autonomy stack integrates RTAB-Map visual SLAM, Nav2 with A* and Theta* planning, and AprilTag localization, alongside LiDAR/depth-camera point clouds and PyTorch U-Net segmentation. C++ socket telemetry feeds robot state and sensor feedback to a real-time React operator interface. January 2026 – Present.',
    tags: ['ROS 2', 'C++', 'React', 'Nav2', 'PyTorch'],
    image: '/brunorover.png',
  },
  {
    title: 'Hoos Taking Notes',
    detailHref: '/projects/hoos-taking-notes/',
    description: 'For my Software Engineering class, we decided to try and develop a note sharing platform, aptly named "Hoos Taking Notes" since our school calls students "Hoos". Here, we had to learn to use Django, PostgreSQL, Amazon S3, and deployment on Heroku, in order to create the application. During this class, we learned about several software development methods, and we also employed the "Scrum" ideology. For my group, I was designated as Scrum Lead, and I make sure we\'re having weekly check-ins, taks designations, and that we\'re meeting deadlines as a group. At the time of writing this, the project is still underway, but most of the meat of it is done, and I\'m excited to update this page with more info!',
    tags: ['Django', 'PostgreSQL', 'Amazon S3', 'Heroku'],
    image: '/hoostakingnotes.png',
    imageAlt: 'Hoos Taking Notes homepage with a course notes search and sign-in panel',
  },
  {
    title: 'TOP Compiler Extensions',
    detailHref: '/projects/top-compiler-extensions/',
    href: 'https://github.com/NoodleBirb/sopc-edwards',
    description: 'For my Fall 2026 Compilers class, I was expected to extend a compiler for TOP, to include several new features, and had to work through it via careful planning and close knowledge of the compilation pipeline! It was split into several stages, with the first being parsing, but eventually we made it all the way to code generation, allowing us to run our programs using newly added for loops, sequences, and lambdas.',
    tags: ['Compiler Design', 'Type Checking', 'Memory Safety'],
    image: '/compilation.png',
    imageAlt: 'TOP compilation pipeline from ANTLR parsing through frontend processing, type checking and memory safety, to LLVM code generation',
    imageFit: 'contain',
  },
  {
    title: 'Incremental Haven',
    detailHref: '/projects/incremental-haven/',
    href: 'https://ethanedwards.dev/Incremental-Haven/',
    description: 'A personal game that tracks 10+ values, structured modularly for later additions, with a research notebook of the development process. August 2024 – June 2025.',
    tags: ['Game', 'Blender', 'Unity', 'C#'],
    image: '/incrementalhaven.png',
  },
  {
    title: 'Past projects',
    detailHref: '/projects/past-projects/',
    href: '/past-projects/',
    description: 'This is a list of projects I worked on before I became more adept at programming in general. Though I\'m not exactly proud of them now, they do still hold a special place in my heart!',
    tags: ['Archive', 'JavaScript', 'HTML'],
  },
];
---
<BaseLayout title="Ethan Edwards | Developer" description="Ethan Edwards, a Computer Science student at the University of Virginia.">
  <header class="site-header">
    <div class="site-header-inner page-width">
      <a class="wordmark" href="#top" aria-label="Back to the top">ethanedwards.dev</a>
      <nav aria-label="Main navigation">
        <a href="#top">Home</a>
        <a href="#projects">Projects</a>
        <a href="/resume.pdf">Resume</a>
      </nav>
    </div>
  </header>

  <main id="top" class="page-width">
    <section class="intro" aria-labelledby="intro-title">
      <p class="eyebrow">Hello, I'm Ethan</p>
      <h1 id="intro-title">Computer science at UVA</h1>
    </section>

    <section id="about" class="about section-grid" aria-labelledby="about-title">
        <div class="portrait-frame">
          <img class="portrait-placeholder" src="/portrait.jpg" alt="Ethan Edwards pointing at the water with teammates on a pier" />
        </div>
      <div class="about-copy ruled-panel">
        <h2 id="about-title">About me</h2>
        <p>My name is Ethan Edwards and I've been passionate about Computer Science since middle school! I have a general passion for learning more about how computers can interact with things around me, and I'm always looking for new experiences.</p>
        <p>Currently, I'm pursuing a B.A. in Computer Science at the University of Virginia, planning to graduate in May 2028, and I'm learning more every single day!</p>
        <p>Right now, I'm passionate about rock climbing and I love playing games with my friends. I currently climb about V6, but I have a lifelong goal of V13!</p>
      </div>
    </section>

    <section id="experience" class="experience section-block" aria-labelledby="experience-title">
      <h2 id="experience-title" class="section-title">Work experience</h2>
      <div class="experience-list">
        {experience.map((role) => (
          <article class="work-card ruled-panel">
            {role.image && (
              <div class:list={['work-media', { 'is-contain': role.imageFit === 'contain' }]}>
                <img src={role.image} alt="" />
              </div>
            )}
            <div class="work-copy">
              <h3>{role.title}</h3>
              <p class="item-org">{role.organization}</p>
              {role.description.map((paragraph) => <p>{paragraph}</p>)}
              <a class="learn-more" href={role.detailHref} aria-label={`Learn more about ${role.title} at ${role.organization.split(' · ')[0]}`}>Learn More</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="projects" class="projects section-block" aria-labelledby="projects-title">
      <h2 id="projects-title" class="section-title">Selected projects</h2>
      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card">
            {project.image && project.href && (
              <a class:list={['project-media', { 'is-contain': project.imageFit === 'contain' }]} href={project.href} tabindex="-1" aria-hidden="true">
                <img src={project.image} alt="" />
              </a>
            )}
            {project.image && !project.href && (
              <div class:list={['project-media', { 'is-contain': project.imageFit === 'contain' }]}>
                <img src={project.image} alt={project.imageAlt ?? ''} />
              </div>
            )}
            <div class="project-heading">
              <h3>{project.title}</h3>
              {project.href && <a href={project.href} aria-label={`View ${project.title}`}>↗</a>}
            </div>
            <p>{project.description}</p>
            <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
            <a class="learn-more" href={project.detailHref} aria-label={`Learn more about ${project.title}`}>Learn More</a>
          </article>
        ))}
      </div>
    </section>

  </main>

  <footer id="contact" class="site-footer">
    <div class="page-width footer-inner">
      <div>
        <p class="section-kicker">Contact me at:</p>
        <h2><a href="mailto:ethan.edwards750@gmail.com">ethan.edwards750@gmail.com</a></h2>
      </div>
      <div class="contact-links">
        <div class="social-links">
          <a href="https://github.com/NoodleBirb">GitHub</a>
          <a href="https://www.linkedin.com/in/ethan-edwards-14b537367/">LinkedIn</a>
          <a href="/past-projects/">Past projects</a>
          <a href="/resume.pdf">Resume</a>
          <a href="#top">Back to top ↑</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom page-width"><span>© 2026 Ethan Edwards</span></div>
  </footer>
</BaseLayout>
